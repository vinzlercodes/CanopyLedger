{
  "components": {
    "schemas": {
      "BundleReference": {
        "additionalProperties": false,
        "description": "Pinned immutable version-bundle reference.",
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "resource_id": {
            "pattern": "^[a-z]{3}_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Resource Id",
            "type": "string"
          }
        },
        "required": [
          "resource_id",
          "digest"
        ],
        "title": "BundleReference",
        "type": "object"
      },
      "CreateFacility": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "facility_commitment": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Facility Commitment"
          },
          "legal_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Legal Name",
            "type": "string"
          }
        },
        "required": [
          "legal_name",
          "currency",
          "facility_commitment"
        ],
        "title": "CreateFacility",
        "type": "object"
      },
      "FacilityResponse": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "facility_commitment": {
            "title": "Facility Commitment",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "legal_name": {
            "title": "Legal Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "legal_name",
          "currency",
          "facility_commitment",
          "version"
        ],
        "title": "FacilityResponse",
        "type": "object"
      },
      "FreezeFacility": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "computation_bundle": {
            "$ref": "#/components/schemas/BundleReference"
          },
          "inputs": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SnapshotInputReference"
            },
            "title": "Inputs",
            "type": "array"
          },
          "legal_interpretation_bundle": {
            "$ref": "#/components/schemas/BundleReference"
          },
          "market_bundle": {
            "$ref": "#/components/schemas/BundleReference"
          },
          "policy_bundle": {
            "$ref": "#/components/schemas/BundleReference"
          }
        },
        "required": [
          "as_of",
          "market_bundle",
          "policy_bundle",
          "legal_interpretation_bundle",
          "computation_bundle"
        ],
        "title": "FreezeFacility",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SnapshotInputReference": {
        "additionalProperties": false,
        "description": "One immutable input included in a snapshot.",
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "resource_id": {
            "pattern": "^[a-z]{3}_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Resource Id",
            "type": "string"
          },
          "resource_type": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "title": "Resource Type",
            "type": "string"
          }
        },
        "required": [
          "resource_type",
          "resource_id",
          "digest"
        ],
        "title": "SnapshotInputReference",
        "type": "object"
      },
      "SnapshotManifestResponse": {
        "properties": {
          "as_of": {
            "title": "As Of",
            "type": "string"
          },
          "computation_bundle": {
            "$ref": "#/components/schemas/BundleReference"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "title": "Created By",
            "type": "string"
          },
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "facility_id": {
            "title": "Facility Id",
            "type": "string"
          },
          "facility_working_version": {
            "title": "Facility Working Version",
            "type": "integer"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/SnapshotInputReference"
            },
            "title": "Inputs",
            "type": "array"
          },
          "legal_interpretation_bundle": {
            "$ref": "#/components/schemas/BundleReference"
          },
          "market_bundle": {
            "$ref": "#/components/schemas/BundleReference"
          },
          "policy_bundle": {
            "$ref": "#/components/schemas/BundleReference"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "string"
          },
          "snapshot_id": {
            "title": "Snapshot Id",
            "type": "string"
          }
        },
        "required": [
          "snapshot_id",
          "facility_id",
          "facility_working_version",
          "schema_version",
          "as_of",
          "market_bundle",
          "policy_bundle",
          "legal_interpretation_bundle",
          "computation_bundle",
          "inputs",
          "created_by",
          "created_at",
          "digest"
        ],
        "title": "SnapshotManifestResponse",
        "type": "object"
      },
      "UpdateFacility": {
        "additionalProperties": false,
        "properties": {
          "legal_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Legal Name",
            "type": "string"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "legal_name",
          "reason"
        ],
        "title": "UpdateFacility",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "CanopyLedger API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/facilities": {
      "post": {
        "operationId": "createFacility",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFacility"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FacilityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem Details"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Facility"
      }
    },

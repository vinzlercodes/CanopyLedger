{
  "components": {
    "schemas": {
      "BundleReference": {
        "additionalProperties": false,
        "description": "Pinned immutable version-bundle reference.",
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "resource_id": {
            "pattern": "^[a-z]{3}_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Resource Id",
            "type": "string"
          }
        },
        "required": [
          "resource_id",
          "digest"
        ],
        "title": "BundleReference",
        "type": "object"
      },
      "CbbCertificateContributionResponse": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "source_type": {
            "title": "Source Type",
            "type": "string"
          }
        },
        "required": [
          "source_type",
          "source_id",
          "amount"
        ],
        "title": "CbbCertificateContributionResponse",
        "type": "object"
      },
      "CbbCertificateDemoRequest": {
        "additionalProperties": false,
        "properties": {
          "certificate_id": {
            "pattern": "^cbb_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Certificate Id",
            "type": "string"
          },
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/CbbContributionInput"
            },
            "minItems": 1,
            "title": "Contributions",
            "type": "array"
          },
          "facility_id": {
            "pattern": "^fac_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Facility Id",
            "type": "string"
          },
          "facility_limit": {
            "$ref": "#/components/schemas/MoneyInput"
          },
          "reason_codes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "reserves": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/CbbReserveInput"
            },
            "title": "Reserves",
            "type": "array"
          },
          "snapshot_id": {
            "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Snapshot Id",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/ContractualUsageInput"
          }
        },
        "required": [
          "certificate_id",
          "snapshot_id",
          "facility_id",
          "facility_limit",
          "contributions",
          "usage"
        ],
        "title": "CbbCertificateDemoRequest",
        "type": "object"
      },
      "CbbCertificateReserveResponse": {
        "properties": {
          "amount": {
